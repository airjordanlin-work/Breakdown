# Optional tuning — copy to .env and adjust as needed

# MediaPipe pose confidence thresholds (0.0–1.0)
POSE_MIN_DETECTION_CONFIDENCE=0.5
POSE_MIN_TRACKING_CONFIDENCE=0.5

# DTW comparison interval (every N frames)
DTW_EVERY_N_FRAMES=3

# Sliding window length (frames)
POSE_WINDOW_LEN=60

# Default video source: webcam | demo/sample.mp4
DEFAULT_SOURCE=webcam

# Shared secret for the tunnel. The tunnel URL is public while it runs, so set this
# before you start one. Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Leave empty only for localhost. Never commit the real .env.
ACCESS_TOKEN=

# Extra hostnames Vite should accept (comma-separated). Vite does not read this file,
# so export it in the shell that runs npm run dev. Example for a named
# Cloudflare tunnel: ALLOWED_HOSTS=coach.example.com
# ALLOWED_HOSTS=

# Spend limits for questions to the coach (typed or spoken). Enforced on the server.
# Starting guesses, not measured: tune after real use. The daily budget is shared by
# every session and resets when the backend restarts or the day changes.
CHAT_TURNS_PER_MIN=4
CHAT_TURNS_PER_SESSION=30
CHAT_DAILY_TOKENS=40000
